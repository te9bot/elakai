# =============================================================================
# ELAKAI environment
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored; never commit
# real values.
#
# Anything prefixed VITE_ is inlined into the client bundle at build time and
# is therefore PUBLIC. Only put values here that are safe to publish.
# =============================================================================

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
# Dashboard -> Project Settings -> Data API -> Project URL
VITE_SUPABASE_URL=

# Supabase anon/publishable key.
# Dashboard -> Project Settings -> API Keys -> anon public
#
# Safe to ship: it grants no authority on its own. Every table is under Row
# Level Security, so this key can read published rows and nothing else.
VITE_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# NOT environment variables — do not add these.
#
#   service_role key   bypasses all RLS. Dashboard only. Never in .env, never
#                      in CI for a static build, never prefixed with VITE_.
#   database password  used by migration tooling from your machine, not by the
#                      app.
#
# If a service_role key is ever committed or built into a bundle, rotate it in
# the Supabase dashboard immediately — it grants full read/write on every table.
# -----------------------------------------------------------------------------
